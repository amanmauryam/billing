{
  "name": "offline-shop-pos",
  "version": "1.0.0",
  "private": true,
  "description": "Locally compiled Tailwind CSS for the Offline Shop POS.",
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/output.css --minify",
    "watch:css": "tailwindcss -i ./static/css/input.css -o ./static/css/output.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/cli": "^4.0.0",
    "lucide-static": "^1.56.0",
    "tailwindcss": "^4.0.0"
  }
}
